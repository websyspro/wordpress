{
  "name": "websyspro/wordpress",
  "description": "WordPress runtime installer for Composer-based projects",
  "version": "1.0.2",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Wordpress\\Themes\\": "src/"
    }
  },
  "scripts": {
    "install-wp": [
      "vendor/bin/install"
    ],
    "post-create-project-cmd": [
      "@composer dump-autoload",
      "@install-wp"
    ],
    "publish": "php vendor/bin/publish"
  },
  "authors": [
    {
      "name": "Emerson Thiago",
      "email": "websyspro.services@gmail.com"
    }
  ],
  "require": {
    "websyspro/wpengine": "^1.0",
    "websyspro/devtools": "^1.0"
  },
  "extra": {
    "wordpress": {
      "version": 6.9
    }
  }
}
